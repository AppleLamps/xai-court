# Copy keys into `.env.local` — never commit real secrets.

# Required for /api/sketch
XAI_API_KEY=

# Optional: multipart upload ceiling for browser-side prep (pixels + JPEG tuning).
# Capped automatically at xAI’s 20 MiB ceiling. Omit locally for 20 MiB; Vercel builds default ~4.5 MiB unless set.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=
